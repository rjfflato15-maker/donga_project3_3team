# Supabase / PostgreSQL 데이터베이스 연결 설정 가이드
# 이 파일을 복사하여 backend/.env 파일로 만든 후 실제 접속 정보를 입력하세요.

DB_USER=postgres.your_project_id
DB_PASSWORD=your_password
DB_HOST=aws-0-ap-northeast-2.pooler.supabase.com
DB_PORT=6543
DB_NAME=postgres

# 또는 직접 DATABASE_URL을 지정할 수도 있습니다:
# DATABASE_URL=postgresql+psycopg2://[user]:[password]@[host]:6543/postgres

# 로컬 LLM: AI 근거/검토 화면을 적용하기 전에는 비활성화 유지
APP_LLM_ENABLED=false
APP_OLLAMA_URL=http://127.0.0.1:11434
APP_LLM_MODEL=qwen3:latest
APP_LLM_TIMEOUT=45
# v4는 dev2 개선 정책. 사람 확인·최종 평가 전에는 명시적으로 선택해 비교합니다.
APP_LLM_GUARD_POLICY=v3
# 실행 계정의 ~/.ollama/server.json에서 disable_ollama_cloud=true + Ollama 재시작 필요
