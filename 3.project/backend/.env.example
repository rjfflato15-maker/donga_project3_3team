# 로컬 실행 예시. 필요할 때 backend/.env로 복사하며 실제 .env는 제출하지 않습니다.
# pilot은 storage/pilot/pilot.db(SQLite)를 사용합니다. 외부 DB 계정은 필요 없습니다.
APP_DEPLOYMENT_MODE=pilot
APP_NTS_MODE=disabled
APP_COOKIE_SECURE=false
# 개발 업무함을 분리하려면 프로젝트 루트에서 실행하면서 아래 경로를 지정합니다.
# APP_STORAGE_ROOT=storage/dev-local

# 모델을 준비한 뒤 원하는 기능만 활성화합니다. API Key는 사용하지 않습니다.
APP_LLM_ENABLED=false
APP_OLLAMA_URL=http://127.0.0.1:11434
APP_LLM_MODEL=qwen3:latest
APP_LLM_TIMEOUT=45
# 코드 기본 정책을 명시합니다. 고정 v4 평가와 현재 실행 설정은 별개입니다.
APP_LLM_GUARD_POLICY=v3
APP_VLM_ENABLED=false
APP_VLM_MODEL=qwen2.5vl:7b
APP_VLM_TIMEOUT=90
# 실행 계정의 ~/.ollama/server.json에서 disable_ollama_cloud=true + Ollama 재시작 필요
# EXE는 storage/launcher/settings.json의 llm_enabled/vlm_enabled를 우선합니다.
# 주요 설정 설명: docs/ai/runtime_settings.md

# 선택 사항: development 모드에서 외부 PostgreSQL을 사용할 때만 설정합니다.
# APP_DEPLOYMENT_MODE=development
# DATABASE_URL=postgresql+psycopg2://YOUR_USER:YOUR_PASSWORD@YOUR_HOST:6543/postgres
