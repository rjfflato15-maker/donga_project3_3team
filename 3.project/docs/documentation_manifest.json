  "code_contracts": [
    {
      "name": "업무함 기본 10초",
      "source": "frontend/src/hooks/useAutoRefresh.ts",
      "pattern": "AUTO_REFRESH_INTERVAL_MS\\s*=\\s*10_000",
      "document": "docs/api/frontend_integration.md"
    },
    {
      "name": "직접 실행 LLM 기본 비활성",
      "source": "backend/app/ai/__init__.py",
      "pattern": "getenv\\(\"APP_LLM_ENABLED\", \"false\"\\)",
      "document": "docs/ai/runtime_settings.md"
    },
    {
      "name": "직접 실행 VLM 기본 모델",
      "source": "backend/app/ai/local_vlm.py",
      "pattern": "APP_VLM_MODEL', 'qwen2\\.5vl:7b'",
      "document": "docs/ai/runtime_settings.md"
    },
    {
      "name": "직접 실행 VLM 기본 90초",
      "source": "backend/app/ai/local_vlm.py",
      "pattern": "APP_VLM_TIMEOUT', '90'",
      "document": "docs/ai/runtime_settings.md"
    },
    {
      "name": "정산 엑셀 API",
      "source": "backend/app/api/contract_exports.py",
      "pattern": "settlement-export",
      "document": "docs/operations/accounting_export.md"
    },
    {
      "name": "VLM 후보 자동 반영 없음",
      "source": "backend/app/services/vlm_reread_service.py",
      "pattern": "automatically_applied=False",
      "document": "docs/ai/pipeline.md"
    },
    {
      "name": "자료 버전이 있는 필드 정정",
      "source": "backend/app/services/document_correction_service.py",
      "pattern": "confirmed_fields",
      "document": "docs/api/frontend_integration.md"
    }
  ],
  "erd_document": "docs/architecture/erd.md"
}
